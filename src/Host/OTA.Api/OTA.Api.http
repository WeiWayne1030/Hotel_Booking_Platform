@host = http://localhost:5142
# 對應 InventoryMockData：熱門房型只有 5 間，一般房型 50 間
@scarce = 00000000-0000-0000-0000-000000000101
@normal = 00000000-0000-0000-0000-000000000102

### 查房態：12/1 入住、12/4 退房 (3 晚)
GET {{host}}/api/inventory/availability?roomTypeId={{scarce}}&checkIn=2026-12-01&checkOut=2026-12-04

### 佔位 2 間 (成功回 204)
POST {{host}}/api/inventory/holds
Content-Type: application/json

{
  "bookingId": "11111111-1111-1111-1111-111111111111",
  "roomTypeId": "{{scarce}}",
  "checkIn": "2026-12-01",
  "checkOut": "2026-12-04",
  "quantity": 2
}

### 佔位 6 間 (超過 5 間，預期 409)
POST {{host}}/api/inventory/holds
Content-Type: application/json

{
  "bookingId": "22222222-2222-2222-2222-222222222222",
  "roomTypeId": "{{scarce}}",
  "checkIn": "2026-12-01",
  "checkOut": "2026-12-04",
  "quantity": 6
}
